# VoxPhantom Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/voiphantom"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
REFRESH_TOKEN_SECRET="your-refresh-secret-key-change-this-in-production"

# Auth0
AUTH0_DOMAIN="your-auth0-domain.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH0_CLIENT_SECRET="your-auth0-client-secret"
AUTH0_REDIRECT_URI="http://localhost:3000"
AUTH0_AUDIENCE="https://your-api.com"

# App Settings
NEXT_PUBLIC_ADMIN_EMAIL="admin@voxphantom.com"
NEXTAUTH_URL="http://localhost:3000"